page {
  min-height: 100%;
  overflow-x: hidden;
  background: #fcfaf7;
  color: #282421;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
image,
button,
input {
  box-sizing: border-box;
}

.page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 40rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
}

.card {
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  border: 1rpx solid rgba(80, 68, 58, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(62, 48, 39, 0.07);
}

.primary-button {
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  border: 0;
  border-radius: 24rpx;
  background: #735a9d;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 104rpx;
  overflow: hidden;
  padding: 0 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-button[disabled] {
  opacity: 0.58;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.secondary-button {
  box-sizing: border-box;
  max-width: 100%;
  border: 0;
  background: transparent;
  color: #735a9d;
  font-size: 28rpx;
  line-height: 2.7;
  overflow: hidden;
  padding: 0 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.error,
.muted {
  overflow-wrap: anywhere;
  word-break: break-word;
}

.muted {
  color: #89827c;
}

.error {
  color: #b94f56;
}
