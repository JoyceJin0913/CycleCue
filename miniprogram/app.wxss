page {
  min-height: 100%;
  background: #fcfaf7;
  color: #282421;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 32rpx 64rpx;
}

.card {
  border: 1rpx solid rgba(80, 68, 58, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(62, 48, 39, 0.07);
}

.primary-button {
  border: 0;
  border-radius: 24rpx;
  background: #735a9d;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 104rpx;
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

.secondary-button {
  border: 0;
  background: transparent;
  color: #735a9d;
  font-size: 28rpx;
}

.muted {
  color: #89827c;
}

.error {
  color: #b94f56;
}
