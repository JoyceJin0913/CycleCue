.eyebrow {
  color: #735a9d;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
}

.intro {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.edit-hint {
  margin: 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #f1ebf8;
  color: #654e8c;
  font-size: 25rpx;
  line-height: 1.55;
}

.form-card {
  margin-top: 48rpx;
  padding: 4rpx 32rpx;
}

.field {
  padding: 32rpx 0;
  border-bottom: 1rpx solid #eee9e4;
}

.last-field {
  border-bottom: 0;
}

.label {
  margin-bottom: 14rpx;
  color: #77716b;
  font-size: 24rpx;
}

.fixed-value,
.picker-value {
  font-size: 31rpx;
}

.fixed-value {
  line-height: 1.5;
}

.picker-value {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
}

.picker-value > text:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #735a9d;
  font-size: 38rpx;
}

.preview {
  margin: 32rpx 8rpx 44rpx;
  color: #655d57;
  font-size: 27rpx;
  line-height: 1.6;
}

.error-message {
  margin-top: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.setup-page .primary-button {
  font-size: 29rpx;
}
