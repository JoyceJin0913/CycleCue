<view class="page calendar-page">
  <view class="month-header">
    <view class="month-button" aria-role="button" aria-label="上个月" hover-class="month-button-hover" bindtap="previousMonth">‹</view>
    <view class="month-title">{{monthTitle}}</view>
    <view class="month-button" aria-role="button" aria-label="下个月" hover-class="month-button-hover" bindtap="nextMonth">›</view>
  </view>

  <view class="weekday-row">
    <view wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading muted">正在加载日历…</view>
  <view wx:elif="{{errorMessage}}" class="loading error" bindtap="refresh">{{errorMessage}} · 点击重试</view>

  <view wx:else class="calendar-grid">
    <view
      wx:for="{{cells}}"
      wx:key="localDate"
      class="day plan-{{item.planStatus}} {{item.inCurrentMonth ? '' : 'outside'}} {{selectedDate === item.localDate ? 'selected' : ''}}"
      data-date="{{item.localDate}}"
      bindtap="selectDate"
    >
      <view class="day-number">{{item.dayOfMonth}}</view>
      <view class="indicator state-{{item.state}}">{{item.symbol}}</view>
    </view>
  </view>

  <view class="legend card">
    <view class="legend-item">● 待服</view>
    <view class="legend-item">◇ 白色安慰剂片</view>
    <view class="legend-item">✓ 已服</view>
    <view class="legend-item">— 未服</view>
    <view class="legend-item">! 逾期未记录</view>
    <view class="legend-item">○ 停药日</view>
  </view>

  <view wx:if="{{selectedDetail}}" class="detail card">
    <view class="detail-date">{{selectedDetail.displayDate}}</view>
    <view class="muted">{{selectedDetail.description}}</view>
  </view>
</view>
