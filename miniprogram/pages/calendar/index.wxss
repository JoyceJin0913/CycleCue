.calendar-page {
  width: 100%;
  overflow-x: hidden;
}

.month-header {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.month-title {
  min-width: 0;
  flex: 1;
  font-size: 36rpx;
  font-weight: 650;
  text-align: center;
  white-space: nowrap;
}

.month-button {
  box-sizing: border-box;
  display: flex;
  width: 72rpx;
  height: 64rpx;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #735a9d;
  font-size: 48rpx;
  line-height: 64rpx;
}

.month-button-hover {
  border-radius: 18rpx;
  background: #f0eaf7;
}

.weekday-row,
.calendar-grid {
  box-sizing: border-box;
  display: flex;
  width: 100%;
}

.calendar-grid {
  flex-wrap: wrap;
}

.weekday {
  box-sizing: border-box;
  width: 14.285714%;
  flex: 0 0 14.285714%;
  padding-bottom: 18rpx;
  color: #958e87;
  font-size: 22rpx;
  text-align: center;
}

.day {
  box-sizing: border-box;
  display: flex;
  width: 14.285714%;
  min-height: 94rpx;
  flex: 0 0 14.285714%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 20rpx;
}

.day.selected {
  background: #f0eaf7;
}

.outside {
  opacity: 0.3;
}

.day-number {
  font-size: 25rpx;
}

.indicator {
  height: 32rpx;
  margin-top: 4rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.state-taken {
  color: #5b8665;
}

.state-not_taken,
.state-unrecorded_overdue {
  color: #b94f56;
}

.state-future {
  color: #735a9d;
}

.state-break,
.state-before_start {
  color: #aaa39d;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
}

.legend {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  margin-top: 36rpx;
  padding: 28rpx;
  flex-wrap: wrap;
  color: #716a64;
  font-size: 23rpx;
}

.legend-item {
  max-width: 100%;
  margin: 8rpx 28rpx 8rpx 0;
  white-space: nowrap;
}

.detail {
  margin-top: 24rpx;
  padding: 28rpx;
}

.detail-date {
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.detail .muted {
  line-height: 1.55;
}
