.launch {
  box-sizing: border-box;
  width: 100%;
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.launch .muted {
  width: 100%;
  max-width: 620rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.mark {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: #735a9d;
  color: white;
  font-size: 56rpx;
  font-weight: 700;
}

.name {
  font-size: 42rpx;
  font-weight: 650;
}

.retry {
  margin-top: 24rpx;
  color: #735a9d;
}

.retry::after {
  border: 0;
}
