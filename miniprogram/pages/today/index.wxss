.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.date {
  font-size: 36rpx;
  font-weight: 650;
}

.cycle {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.settings-link {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
  margin: 0;
  padding: 0 22rpx 0 26rpx;
  border: 1rpx solid rgba(115, 90, 157, 0.14);
  border-radius: 999rpx;
  background: #f5f0fa;
  color: #735a9d;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 60rpx;
  white-space: nowrap;
}

.settings-link::after {
  border: 0;
}

.settings-arrow {
  margin-top: -2rpx;
  font-size: 30rpx;
  font-weight: 400;
}

.state-card {
  margin-top: 40rpx;
  padding: 64rpx 36rpx 36rpx;
  text-align: center;
}

.state-kicker {
  color: #735a9d;
  font-size: 24rpx;
  font-weight: 600;
}

.state-title {
  margin-top: 14rpx;
  font-size: 48rpx;
  font-weight: 720;
}

.planned {
  margin-top: 16rpx;
  font-size: 27rpx;
}

.main-action {
  margin-top: 58rpx;
}

.photo-action {
  min-height: 112rpx;
  font-size: 34rpx;
}

.pending-photo,
.recorded-photo {
  display: block;
  width: 100%;
  height: 360rpx;
  margin-top: 36rpx;
  border-radius: 20rpx;
  background: #f0eaf7;
}

.pending-photo + .main-action {
  margin-top: 24rpx;
}

.photo-badge {
  margin-top: 36rpx;
  color: #5a765f;
  font-size: 26rpx;
}

.photo-followup {
  margin-top: 24rpx;
}

.quiet-action {
  color: #89827c;
}

.recorded-time {
  margin: 48rpx 0 16rpx;
  color: #5a765f;
  font-size: 28rpx;
}

.reminder {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 30rpx 32rpx;
  gap: 16rpx;
}

.reminder-copy {
  min-width: 0;
  flex: 1;
}

.reminder-label {
  color: #77716b;
  font-size: 24rpx;
}

.reminder-value {
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reminder-button {
  flex-shrink: 0;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f0eaf7;
  color: #735a9d;
  font-size: 23rpx;
  line-height: 64rpx;
}

.reminder-button::after {
  border: 0;
}

.medical-note {
  margin: 32rpx 12rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
}
