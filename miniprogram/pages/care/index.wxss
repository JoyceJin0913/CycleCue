.intro {
  margin-bottom: 32rpx;
}

.intro .muted {
  line-height: 1.55;
}

.page-title {
  margin-bottom: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  margin: 0 8rpx 14rpx;
  font-size: 27rpx;
  font-weight: 650;
}

.person-card,
.empty-card,
.invite-card,
.error-card,
.loading {
  margin-bottom: 18rpx;
  padding: 28rpx;
  overflow: hidden;
}

.person-header,
.permission-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.permission-row {
  align-items: flex-start;
}

.permission-copy {
  min-width: 0;
  flex: 1;
}

.person-name {
  min-width: 0;
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  margin-top: 10rpx;
  color: #5a765f;
  font-size: 28rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.relationship-badge {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #f1ebf8;
  color: #735a9d;
  font-size: 21rpx;
}

.joined {
  flex-shrink: 0;
  color: #5a765f;
  font-size: 25rpx;
}

.small {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.permission-description {
  max-width: 470rpx;
}

.consent-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.active-consent {
  color: #5a765f;
}

.reminder-panel {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #f7f3fb;
}

.reminder-title {
  color: #655d57;
  font-size: 23rpx;
  font-weight: 650;
}

.reminder-description {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.reminder-action {
  display: inline-flex;
  min-height: 60rpx;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #735a9d;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 650;
}

.reminder-action.disabled {
  opacity: 0.55;
}

.text-action {
  display: inline-block;
  margin-top: 18rpx;
  color: #735a9d;
  font-size: 23rpx;
  line-height: 1.5;
}

.danger-action {
  color: #8a4f4f;
}

.quiet-action {
  color: #827b75;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 25rpx;
}

.name-input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #ded7d1;
  border-radius: 18rpx;
  background: #fcfaf7;
  font-size: 28rpx;
}

.invite-card .primary-button {
  margin-top: 28rpx;
  font-size: 29rpx;
}

.invite-card .secondary-button,
.error-card .secondary-button {
  margin-top: 16rpx;
}

.error-card .error {
  line-height: 1.55;
}
