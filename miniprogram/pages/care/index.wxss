.intro {
  margin-bottom: 32rpx;
}

.intro .muted {
  line-height: 1.55;
}

.page-title {
  margin-bottom: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  margin: 0 8rpx 14rpx;
  font-size: 27rpx;
  font-weight: 650;
}

.person-card,
.empty-card,
.invite-card,
.error-card,
.loading {
  margin-bottom: 18rpx;
  padding: 28rpx;
  overflow: hidden;
}

.row-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.person-name {
  min-width: 0;
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  margin-top: 10rpx;
  color: #5a765f;
  font-size: 28rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.joined {
  flex-shrink: 0;
  color: #5a765f;
  font-size: 25rpx;
}

.small {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.55;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 25rpx;
}

.name-input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid #ded7d1;
  border-radius: 18rpx;
  background: #fcfaf7;
  font-size: 28rpx;
}

.invite-card .primary-button {
  margin-top: 28rpx;
  font-size: 29rpx;
}

.invite-card .secondary-button,
.error-card .secondary-button {
  margin-top: 16rpx;
}

.error-card .error {
  line-height: 1.55;
}
