{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node", "miniprogram-api-typings"],
    "lib": ["ES2020", "DOM"],
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "miniprogram/**/*.ts",
    "cloudfunctions/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
